{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "metrics.json",
  "type": "object",
  "required": ["schema_version", "run_id", "freeze_hash", "status", "metrics", "predictions_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["planned", "running", "completed", "failed", "incomplete"]},
    "metrics": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["run_id", "bundle_id", "source", "target", "model", "selector", "k", "seed", "threshold_policy",
                   "n_rows", "n_domains", "prevalence", "TN", "FP", "FN", "TP", "threshold", "values", "warnings"],
      "properties": {
        "source": {"enum": ["A", "B"]}, "target": {"enum": ["A", "B"]},
        "model": {"enum": ["RF", "LGBM"]}, "selector": {"enum": ["ALL", "MEAN_PI", "STABLE_PI"]},
        "threshold_policy": {"enum": ["f1_max", "fpr_le", "fixed_0.5"]},
        "k": {"type": "integer", "minimum": 1, "maximum": 37},
        "TN": {"type": "integer", "minimum": 0}, "FP": {"type": "integer", "minimum": 0},
        "FN": {"type": "integer", "minimum": 0}, "TP": {"type": "integer", "minimum": 0},
        "prevalence": {"type": "number", "minimum": 0, "maximum": 1},
        "threshold": {"type": "number"},
        "values": {"type": "object", "required": ["f1", "precision", "recall", "specificity", "mcc",
                   "balanced_accuracy", "accuracy", "roc_auc", "average_precision"]}
      }}}
  }
}
